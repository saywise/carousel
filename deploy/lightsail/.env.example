# Production env file for the Lightsail server. Copy to .env next to docker-compose.yml, fill in, chmod 600.
# NODE_ENV, HOST, PORT and DATA_DIR are set by the Dockerfile; do not repeat them here.

# Public hostname Caddy gets a certificate for (its DNS A record must already point at this server).
DOMAIN=studio.saywise.com
# Exact public URL of the studio, including https:// and no trailing slash. Must match DOMAIN.
APP_ORIGIN=https://studio.saywise.com

# Browser login (HTTP Basic auth).
STUDIO_USER=studio
# At least 16 characters. Generate with: openssl rand -base64 24
STUDIO_PASSWORD=

# openai = real generation (billed to your OpenAI key); demo = $0, saved sample content only.
GENERATION_MODE=openai
# Dedicated OpenAI project key with a monthly budget cap set in the OpenAI dashboard.
OPENAI_API_KEY=
# Current app defaults; confirm your OpenAI account has access to both models.
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Must be true for company and job posts to work in openai mode.
ENABLE_WEB_RESEARCH=true

# Optional cost-estimate prices (USD per million tokens / per image / per search). Blank = shown as unknown.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_CACHED_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_IMAGE_USD_EACH=
OPENAI_WEB_SEARCH_USD_EACH=
