{
  "name": "saywise-content-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node dist/server.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:codex": "node --import tsx scripts/smoke-codex.ts",
    "test:openai": "node --import tsx scripts/smoke-openai.ts"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "openai": "^6.0.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
