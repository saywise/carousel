# Server configuration only. No secrets or model settings use VITE_ prefixes.
GENERATION_MODE=demo
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATA_DIR=./data

# Local development only. Uses the CLI's existing ChatGPT login.
CODEX_BIN=codex
CODEX_MODEL=
GENERATION_TIMEOUT_MS=120000

# Permanent production infrastructure
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=6000
ENABLE_WEB_RESEARCH=false

# Optional estimates: enter current prices for the configured models.
# Blank = unknown, never assumed free. USD per million tokens / per image / per search.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_CACHED_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_IMAGE_USD_EACH=
OPENAI_WEB_SEARCH_USD_EACH=

# Required by the production server. Use HTTPS at the reverse proxy.
STUDIO_USER=studio
STUDIO_PASSWORD=
